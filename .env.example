# Copy this file to .env and fill in values for local development.
# In Railway, set these the same names as project variables (the .env file is gitignored and never deployed).

# === Kantata OAuth2 application credentials ===
# Get these from Kantata: Settings -> API -> Register a new application.
# Set the application's callback URI to KANTATA_OAUTH_REDIRECT_URL (below).
KANTATA_CLIENT_ID=
KANTATA_CLIENT_SECRET=

# Where Kantata sends the user back after they approve the OAuth grant.
# Local dev:  http://localhost:8000/oauth/callback
# Production: https://<your-custom-domain>/oauth/callback
# You can register BOTH callback URIs on the same Kantata application.
KANTATA_OAUTH_REDIRECT_URL=http://localhost:8000/oauth/callback

# Optional: a personal OAuth token (Settings -> API -> "Your OAuth Token").
# Only used by the CLI for bulk ops run by the app owner.
# Leave blank if you only intend to use the web UI.
KANTATA_ADMIN_TOKEN=

# === Kantata API endpoints (do not change unless Kantata moves them) ===
KANTATA_API_BASE=https://api.mavenlink.com/api/v1
KANTATA_AUTHORIZE_URL=https://app.mavenlink.com/oauth/authorize
KANTATA_TOKEN_URL=https://app.mavenlink.com/oauth/token

# === App configuration ===
# Local dev uses SQLite by default. In production (Railway) set DATABASE_URL
# to the Postgres connection string provided by the Postgres add-on, with
# the driver prefix `postgresql+asyncpg://`.
DATABASE_URL=sqlite+aiosqlite:///./kantata_timecard.db

# Secret used by SessionMiddleware to sign session cookies.
# Generate a fresh one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string

# Fernet key used to encrypt stored OAuth refresh tokens at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Public base URL of the deployed app (used to construct absolute callback URLs).
# Local: http://localhost:8000
# Prod:  https://timecards.yourcompany.com
BASE_URL=http://localhost:8000

LOG_LEVEL=INFO
